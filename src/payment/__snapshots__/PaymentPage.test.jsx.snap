                After you complete your order you will be able to select course dates from your dashboard.
              </p>
            </div>
          </div>
        </section>
      </div>
      <div
        class="col-md-7 pl-md-5"
      >
        <section
          aria-label="Payment Details"
        >
          <div
            class="basket-section"
          >
            <h5
              aria-level="2"
            >
              Checkout with PayPal
            </h5>
            <p
              class="d-flex flex-wrap"
            >
              <button
                class="payment-method-button active"
                data-testid="PayPalButton"
                type="button"
              >
                <img
                  alt="PayPal"
                  src="test-file-stub"
                />
              </button>
            </p>
          </div>
        </section>
      </div>
    </div>
  </div>
</div>
`;
